{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/neural-harmonic-textures/render-request.schema.json",
  "title": "NHT arbitrary camera render request",
  "type": "object",
  "required": ["schema", "cameras"],
  "properties": {
    "schema": {"const": "nht_render_request_v1"},
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/camera"}
    },
    "appearance_policy": {"$ref": "#/$defs/appearancePolicy"}
  },
  "additionalProperties": false,
  "$defs": {
    "unitInterval": {"type": "number", "minimum": 0, "maximum": 1},
    "appearancePolicy": {
      "type": "object",
      "required": ["point_radius", "splat_order", "splat_stagger"],
      "properties": {
        "point_radius": {"type": "number", "exclusiveMinimum": 0},
        "splat_order": {"enum": ["largest_first"]},
        "splat_stagger": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "required": ["splat_progress", "view_dependence"],
      "properties": {
        "splat_progress": {"$ref": "#/$defs/unitInterval"},
        "view_dependence": {"$ref": "#/$defs/unitInterval"}
      },
      "additionalProperties": false
    },
    "matrix3": {
      "type": "array",
      "minItems": 3,
      "prefixItems": [
        {"type": "array", "minItems": 3, "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number"}, {"type": "number"}], "items": false},
        {"type": "array", "minItems": 3, "prefixItems": [{"type": "number"}, {"type": "number", "exclusiveMinimum": 0}, {"type": "number"}], "items": false},
        {"const": [0, 0, 1]}
      ],
      "items": false
    },
    "matrix4": {
      "type": "array",
      "minItems": 4,
      "prefixItems": [
        {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        {"const": [0, 0, 0, 1]}
      ],
      "items": false
    },
    "camera": {
      "type": "object",
      "required": ["camera_id", "width", "height", "intrinsics", "camera_to_scene"],
      "properties": {
        "camera_id": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "intrinsics": {
          "type": "object",
          "required": ["model", "distortion_model", "params", "matrix"],
          "properties": {
            "model": {"const": "PINHOLE"},
            "distortion_model": {"const": "NONE"},
            "params": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
            "matrix": {"$ref": "#/$defs/matrix3"}
          },
          "additionalProperties": false
        },
        "camera_to_scene": {"$ref": "#/$defs/matrix4"},
        "appearance": {"$ref": "#/$defs/appearance"}
      },
      "additionalProperties": false
    }
  }
}
