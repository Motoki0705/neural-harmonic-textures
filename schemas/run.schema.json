{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/neural-harmonic-textures/run.schema.json",
  "title": "Neural Harmonic Textures pipeline run",
  "type": "object",
  "required": [
    "schema",
    "scene_id",
    "status",
    "input_video",
    "resolved_config",
    "created_at_utc",
    "updated_at_utc",
    "stages"
  ],
  "properties": {
    "schema": {"const": "nht_pipeline_run_v1"},
    "scene_id": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
    "status": {"$ref": "#/$defs/status"},
    "input_video": {"type": ["string", "null"]},
    "resolved_config": {"const": "resolved-config.yaml"},
    "requested_from_stage": {
      "anyOf": [{"$ref": "#/$defs/stageName"}, {"type": "null"}]
    },
    "requested_through_stage": {
      "anyOf": [{"$ref": "#/$defs/stageName"}, {"type": "null"}]
    },
    "created_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frames",
        "preprocess",
        "sfm",
        "sfm_selection",
        "nht_training",
        "scene_export",
        "reconstruction_report"
      ],
      "properties": {
        "frames": {"$ref": "#/$defs/stageRecord"},
        "preprocess": {"$ref": "#/$defs/stageRecord"},
        "sfm": {"$ref": "#/$defs/stageRecord"},
        "sfm_selection": {"$ref": "#/$defs/stageRecord"},
        "nht_training": {"$ref": "#/$defs/stageRecord"},
        "scene_export": {"$ref": "#/$defs/stageRecord"},
        "reconstruction_report": {"$ref": "#/$defs/stageRecord"}
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "status": {
      "enum": ["pending", "running", "completed", "failed", "invalidated", "skipped"]
    },
    "stageName": {
      "enum": [
        "frames",
        "preprocess",
        "sfm",
        "sfm_selection",
        "nht_training",
        "scene_export",
        "reconstruction_report"
      ]
    },
    "nullableDateTime": {
      "anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]
    },
    "stageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "attempts",
        "outputs",
        "summary",
        "error",
        "started_at_utc",
        "finished_at_utc"
      ],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "attempts": {"type": "integer", "minimum": 0},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "summary": {"type": ["object", "null"]},
        "error": {
          "anyOf": [
            {
              "type": "object",
              "required": ["type", "message"],
              "properties": {
                "type": {"type": ["string", "null"]},
                "message": {"type": "string"}
              },
              "additionalProperties": false
            },
            {"type": "null"}
          ]
        },
        "started_at_utc": {"$ref": "#/$defs/nullableDateTime"},
        "finished_at_utc": {"$ref": "#/$defs/nullableDateTime"}
      }
    }
  }
}
